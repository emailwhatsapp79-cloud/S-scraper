{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cpt1"
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/vf-fill",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/poll",
      "schedule": "15 23 * * *"
    },
    {
      "path": "/api/nudge",
      "schedule": "20 23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/card",
      "destination": "/card.html"
    },
    {
      "source": "/book",
      "destination": "/book.html"
    },
    {
      "source": "/ledger",
      "destination": "/ledger.html"
    },
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/rules",
      "destination": "/rules.html"
    },
    {
      "source": "/tt",
      "destination": "/tt.html"
    }
  ],
  "headers": [
    {
      "source": "/tt",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/tt.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
